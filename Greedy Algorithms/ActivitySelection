//Problem: Selecting activities which are non-overlapping
import java.util.Arrays;
public class Main{
        public static int activitySelection(int[][] actis){
            if(actis.length==0) return 0;
            java.util.Arrays.sort(actis,(a,b)->a[1]-b[1]);//lamda statement 
            int count=1;
            int lastEnd=actis[0][1];
            for(int i=1;i<actis.length;i++){
                int start=actis[i][0];
                if(start>=lastEnd){
                    count++;
                lastEnd=actis[i][1];
                }
            }
            return count;
        }
        public static void main(String[] args){
            int[][] actis={{1,2},{3,4},{0,6},{5,7},{8,9},{5,9}};
            System.out.println(activitySelection(actis));
        }
    }
