//Problem: Find the height of a BST.
//Approach: Using recursion and return 1 + max(left, right).
public class BSTHeight{
    static class Node{
        int data;
        Node left,right;
        public Node(int data){
            this.data=data;
            left=right=null;
        }
    }
    Node root;
    int max(int a,int b){
        if(a>b) return a;
        else return b;
    }
    
     int heightBST(Node root){
        if(root==null) return 0;
        int leftHeight=heightBST(root.left);
        int rightHeight=heightBST(root.right);
        return 1+max(leftHeight,rightHeight);
    }
    public static void main(String[] args){
        BSTHeight obj=new BSTHeight();
        obj.root=new Node(8);
        obj.root.left=new Node(5);
        obj.root.right=new Node(10);
        obj.root.right.right=new Node(15);
        System.out.println("Height : "+ obj.heightBST(obj.root));
    }
}
//Time Complexity:O(n)--n-->every node visited.
//Space Complexity:O(h)
